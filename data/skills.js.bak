// ============================================================
// ВЕЙЛАН — СКИЛЛЫ (50)
// Структура:
//   id, name, desc, owner (класс),
//   cost: { mp, sp, res },   — res жжётся только ультами
//   cd,                       — перезарядка (в ходах)
//   target,                   — enemy / self / ally / all_enemy / all_ally
//   type,                     — phys / mag / heal / buff / debuff / control
//   power,                    — базовый множитель урона (1.0 = 100%)
//   status: { id, chance, dur } или null,
//   special: null или строка-ключ для уникальной логики
// ============================================================

