// ============================================================

const CHAPTER_10_QUESTS = {

  // ----------------------------------------------------------
  // 01. Край Разлома
  // ----------------------------------------------------------
  ch10_01_road: {
    id: 'ch10_01_road', name: 'Край Разлома', chapter: 10,
    giver: 'bridge_officer', type: 'reach', target: 'rift', count: 1,
    requires: 'ch9_10_rift', levelReq: 44,
    rewards: { exp: 5000, gold: 1300, items: [{ itemId: 'potion_hp_large', qty: 3 }] },
    desc: 'Ты выходишь за последние ворота Моста и идёшь по голой скале ещё полдня, и на закате видишь его. Разлом не выглядит как дыра в земле. Он выглядит как шов, который кто-то распустил.',
    dialog: {
      start: 'Ты идёшь к Разлому. Ты сам это выбрал.\n\nРоальд стоит у ворот. Не двигается. Смотрит на тебя долго.\n\n— Я тебя пропущу. Я уже сказал. Но запомни одно: то, что ты увидишь, — не враг. Не моб. Это рана. И рана смотрит в ответ.\n\nОн отступает в сторону.',
      progress: 'Ты ещё не на краю. Разлом гудит. Слышишь?',
      complete: 'Ты.\n\nОн не поворачивается. Говорит в два голоса — один мужской, второй тише, как эхо.\n\n— Я тебя видел. Раньше. Не помню где. Может, до. Может, после. Ты не первый, кто пришёл.\n\nПауза. Он смотрит в Разлом.\n\n— Наблюдатель здесь. Сигмунд. Он считает. Восемь лет считает. Спроси у него, сколько осталось. Он скажет точно. Он всегда говорит точно. Это его способ не сойти с ума.'
    }
  },

  // ----------------------------------------------------------
  // 02. Тетрадь
  // ----------------------------------------------------------
  ch10_02_pages: {
    id: 'ch10_02_pages', name: 'Тетрадь', chapter: 10,
    giver: 'rift_observer', type: 'fetch', target: 'torn_page', count: 3,
    requires: 'ch10_01_road', levelReq: 44,
    rewards: { exp: 6000, gold: 1400, items: [{ itemId: 'scroll_cleanse', qty: 3 }] },
    desc: 'Сигмунд сидит у маленького костра и пишет. Ветер раскидал три страницы его тетради по краю Разлома. Он не может их искать сам. Он не может оставить тетрадь.',
    dialog: {
      start: 'Он пишет. Долго. Ты стоишь рядом, и он наконец поднимает глаза.\n\nНа странице — список. Длинный. Даты. Цифры. Тысячи строк. Он переворачивает страницу. Показывает:\n\n«+3,2 см. Сегодня.»\n\nПауза. Ещё страница:\n\n«Ветер раскидал три страницы. Вчера. Помоги собрать. Они важны — там начало.»',
      progress: 'Три страницы. У скал. Ветер.',
      complete: 'Ты приносишь три страницы. Сигмунд берёт их медленно, читает — каждую строку, будто впервые, хотя это его собственный почерк.\n\nСтраница 1: «День первый. Разлом — три метра. Я пришёл сюда по приказу Синклита. Приказ был: наблюдать. Не вмешиваться.»\n\nСтраница 2: «День сто. Разлом — шесть метров. Я отправил доклад. Ответа нет.»\n\nСтраница 3: «День три тысячи. Разлом — сто восемь метров. Я больше не отправляю докладов. Никто не читает. Я пишу для себя. Чтобы помнить.»\n\nСигмунд закрывает тетрадь. Смотрит на тебя. Впервые — прямо.\n\nПотом открывает снова. Пишет одну строку. Показывает:\n\n«Спасибо. Я допишу».'
    }
  },

  // ----------------------------------------------------------
  // 03. Живой образец
  // ----------------------------------------------------------
  ch10_03_specimen: {
    id: 'ch10_03_specimen', name: 'Живой образец', chapter: 10,
    giver: 'rift_magister', type: 'fetch', target: 'void_wraith_live', count: 1,
    requires: 'ch10_01_road', levelReq: 45,
    rewards: { exp: 7000, gold: 1600, items: [] },
    desc: 'Валентий даёт тебе ловушку — стеклянный шар на верёвке. Он просит живого wraith. Не мёртвого. Мёртвых он видел. Мёртвый — материя. Живой — разговор.',
    dialog: {
      start: 'О! Пришёл! Хорошо, хорошо, я как раз думал, кого послать. Все отказываются. Скучные.\n\nОн хлопает тебя по плечу.\n\n— Мне нужен живой wraith. Не мёртвый. Мёртвых я видел. Мёртвый — это просто материя. А живой — это разговор.\n\nОн даёт тебе стеклянный шар на верёвке.\n\n— Ловушка. Положишь в Разлом, где wraith ходят. Не бей их. Просто стой рядом. Когда почувствуешь холод — дёрни верёвку. Он втянется.\n\nПауза. Он улыбается.\n\n— Три попытки. Если поймаешь — принесёшь. Если нет — не страшно. Я терпеливый.',
      progress: 'Ловушка стоит. Ты ждёшь. Холод придёт.',
      complete: 'Ты чувствуешь холод. Резкий, короткий, как прикосновение чужой руки. Дёргаешь верёвку. Шар наполняется чем-то тёмным. Оно двигается внутри.\n\nВалентий принимает шар двумя руками. Смотрит. Долго.\n\n— Прекрасно. Прекрасно. Живой.\n\nОн садится. Впервые — садится. Держит шар в руках.\n\n— Знаешь, что самое страшное? Не Бездна. Самое страшное — что мы её не понимаем. Триста лет смотрим — и не понимаем. Может, поэтому я хочу открыть. Может, чтобы просто понять.'
    }
  },

  // ----------------------------------------------------------
  // 04. Рот
  // ----------------------------------------------------------
  ch10_04_mouth: {
    id: 'ch10_04_mouth', name: 'Рот', chapter: 10,
    giver: 'rift_mage_1', type: 'reach', target: 'rift_edge_night', count: 1,
    requires: 'ch10_01_road', levelReq: 44,
    rewards: { exp: 5000, gold: 1200, items: [{ itemId: 'scroll_permanent_crit', qty: 1 }] },
    desc: 'Эдрик сидит у костра, помешивает кашу и говорит, что видел ночью. Он не хочет говорить, но говорит. Потому что ты первый, кто слушает.',
    dialog: {
      start: 'Ты... ты мне веришь? Нет? Ну и правильно. Никто не верит. Все умные. Все пишут в тетради.\n\nОн смотрит на Разлом.\n\n— А я видел. Ночью. Один раз. С той стороны. Сначала — как будто вода. Потом — как будто рот. Огромный. Беззубый. Дышит.\n\nПауза.\n\n— Ты сходи сам. Сядь. Подожди. Если увидишь — поймёшь. Я не могу объяснить. Только покажу. Пойдём вместе.',
      progress: 'Ты сидишь. Ждёшь. Ничего.',
      complete: 'Ты сидишь. Час. Два. Эдрик сидит рядом. Не двигается.\n\nПотом — ты видишь. Из Разлома медленно поднимается что-то. Не глаза. Не свет. Рот. Огромный. Беззубый. Он дышит. Ровно. Медленно.\n\nЭдрик плачет. Тихо. Не от страха. От облегчения. Что хоть кто-то ещё увидел.\n\n— Спасибо, — говорит он. — Теперь я не один.'
    }
  },

  // ----------------------------------------------------------
  // 05. Половина
  // ----------------------------------------------------------
  ch10_05_half: {
    id: 'ch10_05_half', name: 'Половина', chapter: 10,
    giver: 'rift_mage_2', type: 'reach', target: 'rift_inside', count: 1,
    requires: 'ch10_01_road', levelReq: 45,
    rewards: { exp: 8000, gold: 1800, items: [] },
    desc: 'Теофан подходит к тебе сам, впервые. Он смотрит на Разлом долго. Потом говорит — тихо, одним голосом, без эха.',
    dialog: {
      start: 'Я ходил туда. Три года назад. Один. Хотел увидеть.\n\nОн говорит одним голосом. Без эха. Впервые.\n\n— Увидел.\n\nПауза.\n\n— Ты можешь войти. На минуту. Не больше. Разлом не пускает надолго, но некоторых пускает посмотреть.\n\nПауза.\n\n— Я не знаю почему. Может, он зовёт. Может, показывает. Там нет мобов. Там вообще нет ничего, что можно ударить. Там — смотришь. И запоминаешь.\n\nОн смотрит на тебя.\n\n— Хочешь? Я провожу. До границы. Дальше сам. Я не пойду снова. Не могу.',
      progress: 'Ты стоишь у границы. Теофан ждёт.',
      complete: 'Ты входишь. Несколько шагов, и всё меняется. Тут нет цвета. Нет звука. Нет воздуха. Есть только ты и что-то, что смотрит.\n\nИ ты видишь. Не глазами. Внутри. Тебя, маленького, в тот день, когда ты родился. Тебя, когда ты впервые боялся. Тебя, когда ты не помог кому-то. Тебя, когда ты мог и не сделал.\n\nРазлом показывает тебя тебе.\n\nИ ты выходишь. Своими ногами. Теофан стоит у границы. Он знал, что ты выйдешь. Он ждал.\n\n— Теперь ты понимаешь, — говорит он тихо. — Почему я вернулся только наполовину.'
    }
  },

