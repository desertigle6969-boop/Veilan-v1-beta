  ch11_03_precursors: {
    id: 'ch11_03_precursors', name: 'Вторая дверь. Палата Предтеч', chapter: 11,
    giver: 'fortress_scout', type: 'fetch', target: 'jar_soul', count: 3,
    requires: 'ch11_02_mother', levelReq: 49,
    rewards: { exp: 6000, gold: 1500, items: [] },
    desc: 'Вторая дверь. Здесь он работал. Триста Предтеч прошли через эти залы.',
    dialog: {
      start: 'Это палата Предтеч, тех, кто был до тебя, тех, кто создавал мир, тех, кого я разбирал по частям, чтобы понять, как устроена Завеса, потому что Завеса — это не стена, это ткань, а ткань плетут из нитей, и нити — это души, и я думал, что если я разберу несколько нитей и посмотрю, как они устроены, я смогу сплести Завесу заново, крепче прежней, чтобы Бездна никогда не смогла её разорвать, и я разобрал триста Предтеч, триста, ты слышишь это число, триста живых существ, которые доверяли мне, которые считали меня своим, которые приходили ко мне сами, потому что я говорил, что знаю путь, и я знал, я действительно знал, но путь был не туда, куда они хотели.',
      progress: 'Их души в банках, на полках, они всё ещё живы, они всё ещё смотрят, они всё ещё помнят, что я с ними сделал, и они не могут умереть, потому что я не позволил, и не могут уйти, потому что я держу, и не могут простить, потому что я не просил прощения, а теперь — поздно, теперь триста лет прошло, и я уже не помню, кто из них кто, и это, наверное, самое тяжёлое — не помнить тех, кого ты убил, потому что убитые заслуживают того, чтобы их помнили, а я — забыл.',
      complete: 'Возьми три банки, три, не больше, потому что остальные уже не хотят уходить, они привыкли, они смирились, они стали частью этих стен, а эти три — ещё держатся, ещё ждут, ещё верят, что кто-то придёт и отпустит их, и вот — приходишь ты, и ты их отпустишь, и это, может быть, единственное доброе дело, которое случится в этих стенах за триста лет.'
    }
  },

  ch11_04_children: {
    id: 'ch11_04_children', name: 'Третья дверь. Огонь, в котором спят дети', chapter: 11,
    giver: 'fortress_scout', type: 'fetch', target: 'child_toy', count: 3,
    requires: 'ch11_03_precursors', levelReq: 49,
    rewards: { exp: 7000, gold: 1600, items: [] },
    desc: 'Третья дверь. Здесь он уговаривал. Словами, не силой.',
    dialog: {
      start: 'Тридцать горнов, и в каждом — ребёнок, и каждый ребёнок — младший сын или младшая дочь в семье кузнеца, и я приходил к их родителям сам, лично, и говорил им то, что говорил всем, потому что умел говорить, потому что был их Тэрном, их надеждой, их будущим, и я говорил: «Ваш сын может спасти мир, ваша дочь может стать огнём, который держит Завесу, это честь, высшая честь, которую может получить Гранн», и они соглашались, все, каждый, и отдавали мне своих детей, и целовали их в лоб, и говорили: «Иди, сынок, ты спасаешь нас», и дети шли, и я вёл их сюда, и они ложились в огонь, и засыпали, и не просыпались больше никогда, но и не умирали, потому что в этом огне нельзя умереть, в этом огне можно только спать, и они спят триста лет, и им снятся хорошие сны, я позаботился об этом, я дал им хорошие сны, потому что не мог дать им жизни.',
      progress: 'Ты видишь их лица, ты видишь их улыбки, они улыбаются во сне, потому что я сказал им, что они спасают мир, и они верят, они всё ещё верят, и я не знаю, что страшнее — то, что они спят, или то, что они улыбаются, потому что если бы они плакали, я знал бы, что делаю зло, но они улыбаются, и значит, для них это хорошо, а для меня — это единственное, что осталось от моей совести, потому что всё остальное я сжёг, я сжёг всё, что во мне было человеческого, ещё до того, как сжёг Завесу.',
      complete: 'Возьми три игрушки, три, те, что лежат рядом с ними, потому что дети, когда шли сюда, принесли с собой самое дорогое, кто коня, кто куклу, кто деревянный меч, и оставили их у горнов, чтобы было не так страшно, и вот эти игрушки — последнее, что осталось от них в этом мире, а теперь — у тебя, и ты вернёшь их родителям, если найдёшь, а если не найдёшь — то просто сохрани, потому что кто-то должен помнить, кто-то должен хранить, а я не могу, я не могу больше ничего хранить, я всё растерял.'
    }
  },

  ch11_05_nirna: {
    id: 'ch11_05_nirna', name: 'Четвёртая дверь. Комната, где идёт снег', chapter: 11,
    giver: 'fortress_scout', type: 'reach', target: 'nirna_room', count: 1,
    requires: 'ch11_04_children', levelReq: 50,
    rewards: { exp: 8000, gold: 1800, items: [] },
    desc: 'Четвёртая дверь. Здесь говорила Нирна. Здесь идёт снег. Триста лет.',
    dialog: {
      start: 'Это комната Нирны, первой тени, той, что разбила Изначальный Свет на семь осколков и выковала из них мир, и она пришла ко мне сама, потому что знала, что я задумал, и хотела остановить, и говорила со мной долго, как мать говорит с сыном, которого любит, но не может спасти, и говорила: «Тэрн, то, что ты делаешь, разорвёт Вейлан, мир не переживёт ещё одного Раскола, остановись, пока есть время», а я ответил ей то, что отвечал всем, и она замолчала, и посмотрела на меня долго, и сказала: «Потому что он мой, даже плохой, даже сломанный, даже тот, который я сама не могу исправить, он мой, и я буду защищать его, пока во мне есть сила».',
      progress: 'И тогда я сказал ей то, что убило её, не мечом, не огнём, не Бездной, — словами, я сказал: «Ты ошибка, ты разбила Свет и создала не мир, а ошибку, всё, что было плохого в Вейлане, — от тебя, всё, что было хорошего, — вопреки тебе», и она рассыпалась прямо здесь, на этом полу, от моих слов, и когда она исчезала, я стоял и смотрел, и не поднял руки, и не сказал «прости», и не сделал ничего, потому что в тот момент я уже был не человеком, а чем-то другим, и это что-то другое — не знает, что такое прощение.',
      complete: 'С тех пор здесь идёт снег, это её слёзы, они падают с тех самых пор и никогда не кончатся, потому что её больше нет, а слёзы — есть, и ты можешь взять горсть, если хочешь, но лучше не бери, потому что слёзы первой тени — не то, что стоит носить с собой, они тяжелее любого оружия, и они не дадут тебе спать, и ты будешь каждую ночь видеть её руку в снегу, тянущуюся к двери, которая никогда не откроется.'
    }
  },

  ch11_06_olden: {
    id: 'ch11_06_olden', name: 'Пятая дверь. Комната Ольдена', chapter: 11,
    giver: 'fortress_scout', type: 'fetch', target: 'olden_diary', count: 1,
    requires: 'ch11_05_nirna', levelReq: 50,
    rewards: { exp: 8000, gold: 1800, items: [] },
    desc: 'Пятая дверь. Здесь жил друг. Он писал ему каждый день.',
    dialog: {
      start: 'Это комната Ольдена, моего друга, моего самого близкого друга, которого у меня никогда не было, потому что друзей у меня не было, а он — был, мы познакомились, когда нам было по двадцать, вместе учились у Предтеч, вместе мечтали о том, как спасём мир, вместе хотели стать теми, кто вернёт Свет, и он вёл дневник с двадцати лет, каждый день, каждую ночь, каждое утро, он записывал всё — мысли, сомнения, страхи, надежды, — и в последний день перед Расколом он написал: «Друг мой, я знаю, что ты задумал, я знаю, потому что ты никогда не умел скрывать от меня ничего, я приду к тебе, поговорим, я не буду тебя останавливать, я просто хочу понять — почему».',
      progress: 'И он пришёл, он стоял передо мной в тронном зале, и смотрел на меня так, как смотрят на человека, которого знали всю жизнь и не узнают сейчас, и спросил: «Тэрн, зачем?» — а я не ответил, я не мог ответить, потому что не помнил, зачем, я помнил только, что надо, и тогда я сделал то, чего не делал ни с кем, кроме Нирны, я вошёл в его разум, я вырезал из него всё хорошее, оставил только страх, и он остался жив, физически, но душа его — та, что любила, та, что верила, та, что писала в дневнике каждый день, — умерла в тот момент, и всё, что осталось, — это тень на троне, которая триста лет боялась того, кого любила, и не помнила почему.',
      complete: 'Возьми дневник, прочти последнюю запись, и скажи мне одно слово, одно, то, которое он написал мне в последний раз, и я услышу, впервые за триста лет услышу то, что не захотел услышать тогда, и может быть, после этого мне станет легче, а может — хуже, но в любом случае — это то, чего я ждал всё это время, и то, чего я боялся больше всего.'
    }
  },

  ch11_07_office: {
    id: 'ch11_07_office', name: 'Шестая дверь. Кабинет', chapter: 11,
    giver: 'fortress_scout', type: 'fetch', target: 'turn_map', count: 1,
    requires: 'ch11_06_olden', levelReq: 51,
    rewards: { exp: 8000, gold: 1800, items: [] },
    desc: 'Шестая дверь. Здесь он думал. Здесь всё началось.',
    dialog: {
      start: 'Это мой кабинет, здесь я придумал то, что привело к Расколу, не здесь я принял решение, оно пришло раньше, но здесь я его оформил, здесь я написал план, здесь я посчитал, сколько душ понадобится, сколько огня, сколько времени, здесь я впервые написал слово «Завеса» не как «граница», а как «инструмент», потому что я думал, что если я разберу её на части и соберу заново, я смогу сделать её крепче, я не понимал, что каждая часть — это живая душа, я не понимал, что, разбирая Завесу, я разбираю тех, кто её держал, я был учёным, я был исследователем, я был тем, кто спасает мир, и я уничтожил его.',
      progress: 'Двести четырнадцать экспериментов, я записывал каждый, я называл их «экспериментами», потому что «эксперимент» — это слово, которое делает чудовищное допустимым, я не убивал, я экспериментировал, я не мучил, я исследовал, я не ломал, я тестировал, — а потом, на двести пятнадцатом, девочка лет шести посмотрела на меня, когда я отделял её душу, и не заплакала, и спросила: «Дядя Тэрн, а мне будет больно?» — и я сказал «нет», и соврал, и ей было больно, и мне тоже было больно, впервые за всё время — мне было больно, и я понял, что делаю, но было поздно, потому что те, кто был до неё, уже были в банках, в огне, на полках, и я не мог их вернуть, я мог только идти вперёд, и я пошёл, и когда дошёл до конца — я сломал Завесу, не потому что хотел, а потому что уже не мог остановиться.',
      complete: 'Возьми карту, на ней всё, все мои преступления, все мои планы, все мои ошибки, пусть кто-то знает, пусть ты знаешь, потому что тот, кто не знает историю, повторит её, а я не хочу, чтобы кто-то повторил меня, я хочу, чтобы кто-то остановился там, где я не остановился, и если ты — тот, кто остановится, то эта карта тебе не нужна, а если ты — тот, кто пойдёт дальше, то пусть она будет твоим предупреждением.'
    }
  },

  ch11_08_cell: {
    id: 'ch11_08_cell', name: 'Седьмая дверь. Клетка Асгейра', chapter: 11,
    giver: 'fortress_scout', type: 'talk', target: 'fortress_scout', count: 1,
    requires: 'ch11_07_office', levelReq: 51,
    rewards: { exp: 8000, gold: 1800, items: [] },
    desc: 'Седьмая дверь. Здесь сидел тот, кто выжил.',
    dialog: {
      start: 'Здесь сидел Асгейр, тот, кого ты встретил у ворот, он вошёл сюда три года назад с двенадцатью разведчиками, они прошли четыре зала, как ты, смотрели, понимали, шли дальше, а на пятом — я остановил их, не потому что хотел убить, потому что хотел поговорить, я говорил с ними три дня, одного за другим, рассказывал всё то, что рассказываю тебе, и знаешь, что произошло, одиннадцать из них сошли с ума, не выдержали, я не убивал их, я просто говорил, я говорил правду, а правда иногда тяжелее меча, они не выдержали того, что я делал, и того, почему я это делал, и умерли от знания, одиннадцать, один — выжил, Асгейр, он сидел здесь, в этой клетке, ещё три недели, я приносил ему еду и воду, я разговаривал с ним, я спрашивал: «Ты понимаешь?» — он говорил: «Нет», я спрашивал: «Ты прощаешь?» — он говорил: «Нет», я спрашивал: «Что мне делать?» — он говорил: «Не знаю».',
      progress: 'На стене — надпись, свежая, не триста лет, года три, он написал её перед тем, как уйти, я не читал её сначала, не хотел, а потом прочитал, и это было хуже, чем всё, что я слышал от него за три недели, потому что одна строка, одно предложение, и в нём — весь приговор, который я заслужил, и который я до сих пор не могу принять.',
      complete: 'Я выпустил его, через три недели, я сказал: «Иди, скажи им, что я жду», он ушёл, он вернулся домой, он рассказал Маршалу всё, что видел, Маршал собрал три державы, и теперь ты здесь, ты пришёл, не как судья, не как палач, а как тот, кто дослушал до конца, и это больше, чем я имел права ожидать, потому что триста лет — никто не дослушивал, все уходили на середине, все говорили «хватит», все закрывали уши, а ты — дослушал.'
    }
  },

  ch11_09_throne: {
    id: 'ch11_09_throne', name: 'Тронный зал', chapter: 11,
    giver: 'rift_mage_2', type: 'talk', target: 'rift_mage_2', count: 1,
    requires: 'ch11_08_cell', levelReq: 52,
    rewards: { exp: 8000, gold: 2000, items: [] },
