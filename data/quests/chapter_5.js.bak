// ============================================================

const CHAPTER_5_QUESTS = {

  // ----------------------------------------------------------
  // 01. Слово в Храме — старт от Хранителя (Ольдена)
  // ----------------------------------------------------------
  ch5_01_word: {
    id: 'ch5_01_word', name: 'Слово в Храме', chapter: 5,
    giver: 'olden_keeper', type: 'reach', target: 'temple', count: 1,
    requires: 'ch4_06_letter', levelReq: 22,
    rewards: { exp: 1500, gold: 400, items: [{ itemId: 'potion_hp_large', qty: 3 }] },
    desc: 'Ольден: «Слово — у тебя. Два слога. «...-ан-Тэрн». Первый слог я не помню — но его помнит Северин. Он был офицером Империи. Он слышал Слово вблизи. Иди в Затонувший Храм. Найди Скит Мора. Не бойся его. Он не сумасшедший. Он — уставший.»',
    dialog: {
      start: 'Слово — у тебя. «...-ан-Тэрн».\n\nПервый слог я не помню. Я слышал его — но забыл. Триста лет прошло, и я забыл.\n\nНо есть тот, кто не забыл. Отец Северин. Жрец Мора. Он был офицером Империи — вёл отряд к Затонувшему Храму, когда Завеса пала.\n\nОн слышал Слово вблизи. Ближе, чем я.\n\nИди в Скит Мора. Найди его. И не бойся — он не сумасшедший. Он — уставший.',
      progress: 'Ты ещё не в Храме. Иди. Слово ждёт.',
      complete: 'Ты пришёл.\n\n(жрец сидит на камне. смотрит на воду. не поворачивается)\n\nЯ знаю, зачем. Слово. Ольден дал тебе два слога. Хочешь третий.\n\nСадись. Смотреть на воду — это не молитва. Это — просто смотреть на воду. Но иногда приходит ответ.\n\nСлушай. Я расскажу тебе всё. Не потому, что хочу. Потому что ты — первый, кто спросил.'
    }
  },

  // ----------------------------------------------------------
  // 02. Первое воспоминание — ночь, когда море поднялось
  // ----------------------------------------------------------
