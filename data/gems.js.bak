// ============================================================
// ФУНКЦИИ
// ============================================================

function getGem(id) { return GEMS[id] || null; }

function getGemsByTier(tier) {
  return Object.values(GEMS).filter(g => g.tier === tier);
}

function getGemsByStat(stat) {
  return Object.values(GEMS).filter(g => g.stats && g.stats[stat]);
}

function getAllGems() { return Object.values(GEMS); }

// Продажа
function getGemSellPrice(gem) {
  return Math.floor((gem.cost || 0) * CONFIG.gold.sellPriceShare);
}

// Случайный камень для дропа (по уровню моба)
function rollGemByLevel(level) {
  let tier = 1;
  if (level >= 40) tier = 3;
  else if (level >= 15) tier = 2;

  const pool = getGemsByTier(tier);
  if (!pool || pool.length === 0) {
    // Fallback — любой камень
    const all = getAllGems();
    if (all.length === 0) return null;
    return all[Math.floor(Math.random() * all.length)];
  }
  return pool[Math.floor(Math.random() * pool.length)];
}

// ============================================================
// ЭКСПОРТ
// ============================================================

window.Gems = {
  getGem, getGemsByTier, getGemsByStat, getAllGems,
  getGemSellPrice, rollGemByLevel
};


// ============================================================
// РЕГИСТРАЦИЯ КАМНЕЙ В ITEMS
// Камни — тоже предметы. Их можно продавать, хранить в сумке.
// ============================================================

(function() {
  if (typeof ITEMS === 'undefined') {
    console.warn('[gems] ITEMS не найден, регистрация камней пропущена');
    return;
  }
  for (const gemId in GEMS) {
    const gem = GEMS[gemId];
    ITEMS[gemId] = {
      id: gem.id,
      name: gem.name,
      desc: gem.desc,
      lore: gem.lore,
      type: 'gem',
      tier: gem.tier,
      rarity: gem.rarity,
      cost: gem.cost,
      stack: 20,
      stats: gem.stats,
      sprite: gem.sprite
    };
  }
})();
