}

function renderMenuTab(screen) {

  // ========== ПАНЕЛЬ 1: Сохранение ==========
  const savePanel = document.createElement('div');
  savePanel.className = 'panel';

  const saveH2 = document.createElement('h2');
  saveH2.textContent = 'Сохранение';
  savePanel.appendChild(saveH2);

  // Кнопка "Сохранить сейчас"
  const btnSave = document.createElement('button');
  btnSave.className = 'btn btn-primary btn-full';
  btnSave.textContent = 'Сохранить сейчас';
  btnSave.onclick = function() {
    if (!STATE || !STATE.hero) {
      Toast.bad('Нет героя для сохранения');
      return;
    }
    if (Save.saveState()) {
      Toast.good('Сохранение прошло');
    } else {
      Toast.bad('Ошибка сохранения');
    }
  };
  savePanel.appendChild(btnSave);

  // Кнопка "Новая игра"
  const btnNew = document.createElement('button');
  btnNew.className = 'btn btn-danger btn-full';
  btnNew.textContent = 'Новая игра';
  btnNew.onclick = function() {
    Modal.confirm('Удалить текущее сохранение и создать нового героя? Это действие нельзя отменить.', function() {
      // Останавливаем автосейв — иначе он перезапишет удаление
      Save.stopAutoSave();
      Save.deleteSave();
      Toast.info('Сохранение удалено. Перезагрузка...');
      setTimeout(function() {
        location.reload();
      }, 800);
    }, function() {
      // отмена — ничего не делаем
    });
  };
  savePanel.appendChild(btnNew);

  screen.appendChild(savePanel);

  // ========== ПАНЕЛЬ 2: Статистика ==========
  const statsPanel = document.createElement('div');
  statsPanel.className = 'panel';

  const statsH2 = document.createElement('h2');
  statsH2.textContent = 'Статистика';
  statsPanel.appendChild(statsH2);

  const s = STATE.stats || {};

  const rows = [
    { label: 'Убито мобов:',    value: s.mobsKilled || 0 },
    { label: 'Убито боссов:',   value: s.bossesKilled || 0 },
    { label: 'Смертей:',        value: s.deaths || 0 },
    { label: 'PvP-побед:',      value: s.pvpWins || 0 },
    { label: 'PvP-поражений:',  value: s.pvpLosses || 0 },
    { label: 'PvP-очков:',      value: s.pvpPoints || 0 },
    { label: 'Заработано золота:', value: s.goldEarned || 0 },
    { label: 'Потрачено золота:',  value: s.goldSpent || 0 },
    { label: 'Найдено предметов:', value: s.itemsFound || 0 },
    { label: 'Продано предметов:', value: s.itemsSold || 0 }
  ];

  rows.forEach(function(r) {
    const row = document.createElement('div');
    row.style.cssText = 'display:flex;justify-content:space-between;padding:6px 0;font-size:13px;border-bottom:1px solid #2a1f14;';
    row.innerHTML = '<span style="color:#8a7a5a;">' + r.label + '</span>' +
                    '<b style="color:#d4c8a8;">' + r.value + '</b>';
    statsPanel.appendChild(row);
  });

  screen.appendChild(statsPanel);

  // ========== ПАНЕЛЬ 3: Настройки ==========
  const settingsPanel = document.createElement('div');
  settingsPanel.className = 'panel';

  const setH2 = document.createElement('h2');
  setH2.textContent = 'Настройки';
  settingsPanel.appendChild(setH2);

  const settings = (STATE.settings = STATE.settings || { sound: true, animSpeed: 1.0, autoSaveIntervalSec: 30 });

  // Звук
  const soundRow = document.createElement('div');
  soundRow.style.cssText = 'display:flex;justify-content:space-between;align-items:center;padding:8px 0;font-size:13px;border-bottom:1px solid #2a1f14;';
  soundRow.innerHTML = '<span>Звук:</span>';

  const soundBtn = document.createElement('button');
  soundBtn.className = 'btn';
  soundBtn.textContent = settings.sound ? 'Включён' : 'Выключен';
  soundBtn.onclick = function() {
    settings.sound = !settings.sound;
    soundBtn.textContent = settings.sound ? 'Включён' : 'Выключен';
    if (window.Audio_) {
      if (settings.sound) {
        Audio_.enabled = true;
        Audio_.init();
        Audio_.el.play().catch(function(){});
      } else {
        Audio_.enabled = false;
        if (Audio_.el) Audio_.el.pause();
      }
    }
    Save.saveState();
  };
  soundRow.appendChild(soundBtn);
  settingsPanel.appendChild(soundRow);

  // Скорость анимаций
  const speedRow = document.createElement('div');
  speedRow.style.cssText = 'display:flex;justify-content:space-between;align-items:center;padding:8px 0;font-size:13px;';
  speedRow.innerHTML = '<span>Скорость анимаций:</span>';

  const speedBtn = document.createElement('button');
  speedBtn.className = 'btn';
  speedBtn.textContent = 'x' + (settings.animSpeed || 1.0).toFixed(1);
  speedBtn.onclick = function() {
    var speeds = [0.5, 1.0, 1.5, 2.0, 3.0];
    var idx = speeds.indexOf(settings.animSpeed || 1.0);
    idx = (idx + 1) % speeds.length;
    settings.animSpeed = speeds[idx];
    speedBtn.textContent = 'x' + settings.animSpeed.toFixed(1);
    Save.saveState();
  };
  speedRow.appendChild(speedBtn);
  settingsPanel.appendChild(speedRow);

  screen.appendChild(settingsPanel);

  // ========== ПАНЕЛЬ 4: Экспорт / Импорт ==========
  const expPanel = document.createElement('div');
  expPanel.className = 'panel';

  const expH2 = document.createElement('h2');
  expH2.textContent = 'Экспорт / Импорт';
  expPanel.appendChild(expH2);

  const btnExport = document.createElement('button');
  btnExport.className = 'btn btn-full';
  btnExport.textContent = 'Экспортировать сохранение';
  btnExport.onclick = function() {
    if (!STATE || !STATE.hero) {
      Toast.bad('Нет героя для экспорта');
      return;
    }
    var txt = Save.exportSaveToText();
    if (!txt) { Toast.bad('Ошибка экспорта'); return; }
    var ta = document.createElement('textarea');
    ta.value = txt;
    ta.style.cssText = 'width:100%;height:80px;background:#0a0805;color:#e8b84a;border:1px solid #4a3a1e;font-size:10px;margin-top:8px;';
    Modal.open({
      title: 'Экспорт сохранения',
      content: (function() {
        var w = document.createElement('div');
        w.innerHTML = '<p>Скопируй текст ниже и сохрани в безопасном месте:</p>';
        w.appendChild(ta);
        return w;
      })(),
      buttons: [{ text: 'Закрыть', type: 'primary' }],
      closable: true
    });
  };
  expPanel.appendChild(btnExport);

  const btnImport = document.createElement('button');
  btnImport.className = 'btn btn-full';
  btnImport.textContent = 'Импортировать сохранение';
  btnImport.onclick = function() {
    var ta = document.createElement('textarea');
    ta.placeholder = 'Вставь сюда текст сохранения...';
    ta.style.cssText = 'width:100%;height:100px;background:#0a0805;color:#e8b84a;border:1px solid #4a3a1e;font-size:10px;';
    var body = document.createElement('div');
    body.appendChild(ta);
    Modal.open({
      title: 'Импорт сохранения',
      content: body,
      buttons: [
        { text: 'Отмена', type: 'default' },
        { text: 'Загрузить', type: 'primary', close: false, onClick: function() {
          if (!ta.value || !ta.value.trim()) {
            Toast.bad('Вставь текст сохранения');
            return;
          }
          var ok = Save.importSaveFromText(ta.value);
          if (ok) {
            Toast.good('Импорт успешен. Перезагрузка...');
            setTimeout(function() { location.reload(); }, 800);
          } else {
            Toast.bad('Ошибка импорта');
          }
        }}
      ],
      closable: true
    });
  };
  expPanel.appendChild(btnImport);

  screen.appendChild(expPanel);

  // ========== ПАНЕЛЬ 5: О игре ==========
  const aboutPanel = document.createElement('div');
  aboutPanel.className = 'panel';

  const aboutH2 = document.createElement('h2');
  aboutH2.textContent = 'О игре';
  aboutPanel.appendChild(aboutH2);

  const about = document.createElement('p');
  about.style.cssText = 'font-size:12px;line-height:1.6;color:#8a7a5a;';
  about.innerHTML = '<b style="color:#e8b84a;">ВЕЙЛАН</b><br>' +
    'Тёмное фэнтези-RPG<br>' +
    'Версия 0.1 (альфа)<br><br>' +
    'Все данные сохраняются автоматически каждые 30 секунд.';
  aboutPanel.appendChild(about);

  screen.appendChild(aboutPanel);
}

